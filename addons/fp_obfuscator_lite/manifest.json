{
  "manifest_version": 2,
  "name": "FP Obfuscator Lite",
  "version": "0.1.0",
  "description": "Lightweight client-side fingerprint obfuscation for research crawling.",
  "permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
